\contentsline {figure}{\numberline {2.1}{\ignorespaces Posiciones de los electrodos del sistema internacional 10-20 (vista superior). Se resaltan los electrodos de la línea media Fz, Cz, Pz y Oz. Elaboración propia con base en \blx@tocontentsinit {0}\cite {seeck2017}.}}{6}{figure.caption.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Forma de onda ilustrativa de los principales ritmos del EEG. Elaboración propia.}}{7}{figure.caption.3}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces (a) Forma de onda ilustrativa de un ERP ante un estímulo objetivo y uno no objetivo. (b) Efecto del promediado de $N$ ensayos sobre la visibilidad de la componente P300. Señales sintéticas, elaboración propia.}}{9}{figure.caption.6}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Modelo de actualización del contexto de la componente P300. Elaboración propia con base en \blx@tocontentsinit {0}\cite {polich2007}.}}{10}{figure.caption.7}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Secuencia de estímulos en el paradigma del evento raro (\textit {oddball}). Elaboración propia.}}{11}{figure.caption.8}%
\contentsline {figure}{\numberline {2.6}{\ignorespaces Diagrama general de una interfaz cerebro-computadora. Elaboración propia con base en \blx@tocontentsinit {0}\cite {wolpaw2002,wolpaw2012}.}}{12}{figure.caption.9}%
\contentsline {figure}{\numberline {2.7}{\ignorespaces Matriz de $6\times 6$ caracteres del P300 Speller. Si el usuario atiende a la letra N (recuadro), tanto la intensificación de la fila 3 como la de la columna 2 son eventos objetivo que provocan una P300. Las diez intensificaciones restantes son eventos no objetivo. Elaboración propia con base en \blx@tocontentsinit {0}\cite {farwell1988}.}}{13}{figure.caption.10}%
\contentsline {figure}{\numberline {2.8}{\ignorespaces Parámetros de estimulación del P300 Speller con los valores de la base de datos II de la competencia BCI III (F = fila, C = columna). Elaboración propia con base en \blx@tocontentsinit {0}\cite {blankertz2006}.}}{14}{figure.caption.11}%
\contentsline {figure}{\numberline {2.9}{\ignorespaces Densidad espectral de potencia estimada con el método de Welch para una señal de EEG sintética. Elaboración propia.}}{16}{figure.caption.13}%
\contentsline {figure}{\numberline {2.10}{\ignorespaces Respuesta en magnitud de (a) un filtro pasa banda Butterworth de cuarto orden entre 0.1 y 20~Hz y (b) un filtro \textit {notch} en 60~Hz, para $f_s = 240$~Hz. Elaboración propia.}}{17}{figure.caption.14}%
\contentsline {figure}{\numberline {2.11}{\ignorespaces Segmentación de la señal continua en épocas de 0 a 650~ms a partir de cada intensificación. Señal sintética, elaboración propia.}}{18}{figure.caption.15}%
\contentsline {figure}{\numberline {2.12}{\ignorespaces Relación entre la inteligencia artificial, el aprendizaje automático y el aprendizaje profundo. Elaboración propia con base en \blx@tocontentsinit {0}\cite {goodfellow2016}.}}{19}{figure.caption.16}%
\contentsline {figure}{\numberline {2.13}{\ignorespaces Curvas de pérdida de entrenamiento y validación: a partir de cierto punto el modelo comienza a sobreajustarse. Elaboración propia.}}{21}{figure.caption.19}%
\contentsline {figure}{\numberline {2.14}{\ignorespaces Modelo de la neurona artificial y su analogía con la neurona biológica. Elaboración propia con base en \blx@tocontentsinit {0}\cite {aggarwal2018}.}}{22}{figure.caption.20}%
\contentsline {figure}{\numberline {2.15}{\ignorespaces Gráfica de las funciones de activación sigmoide, tangente hiperbólica, ReLU y ELU. Elaboración propia.}}{23}{figure.caption.22}%
\contentsline {figure}{\numberline {2.16}{\ignorespaces Arquitectura general de EEGNet. Elaboración propia con base en \blx@tocontentsinit {0}\cite {lawhern2018}.}}{26}{figure.caption.24}%
\contentsline {figure}{\numberline {2.17}{\ignorespaces Matriz de confusión para la clasificación binaria de épocas. Elaboración propia.}}{28}{figure.caption.26}%
\contentsline {figure}{\numberline {2.18}{\ignorespaces (a) Distribuciones de puntajes de un clasificador para ambas clases y un umbral de decisión. (b) Curvas ROC para distintos grados de separación entre clases. Elaboración propia.}}{29}{figure.caption.28}%
\contentsline {figure}{\numberline {2.19}{\ignorespaces (a) Bits por selección en función de la exactitud para $N=36$ según la Ecuación~\eqref {eq:itr}. (b) ITR teórica en función del número de repeticiones para tres niveles de exactitud, considerando 175~ms por intensificación y 2.5~s entre caracteres. Elaboración propia.}}{30}{figure.caption.29}%
